# Copy to .env and edit. python-dotenv loads it automatically.
#
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
DATABASE_URL=mysql+pymysql://coffeelogs:change-me@localhost:3306/coffeelogs?charset=utf8mb4

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
